# ============================================================
# NextGen Institute Educational ERP API — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git — it is listed in .gitignore.

APP_NAME=NextGen Institute Educational ERP API
APP_VERSION=1.0.0
INSTITUTION_NAME=NextGen Institute of AI & Technology
INSTITUTION_SHORT=NGIAT
SERVICE_NAME=nextgen-edu-api
ENVIRONMENT=development

# ── Database ──────────────────────────────────────────────────
# Local development (PostgreSQL):
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ngiat_erp
# Production (Render — use Internal Connection String from Render PostgreSQL dashboard):
# DATABASE_URL=postgresql+psycopg://user:password@dpg-xxx.oregon-postgres.render.com/nextgen_edu_db

# ── Authentication credentials ────────────────────────────────
# Change ALL of these for any publicly accessible deployment.
BEARER_TOKEN=EDU-BEARER-2026-TEST
API_KEY=EDU-APIKEY-2026-TEST
BASIC_USERNAME=audit_admin
BASIC_PASSWORD=EduPassword@2026

# ── Logging & rate limiting ───────────────────────────────────
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=100

# ── Dataset size for seed scripts ─────────────────────────────
# Controls how many students are generated when running seed scripts.
# Options: small (1,000) | medium (10,000) | large (50,000) | xl (100,000)
# Can be overridden by SEED_STUDENTS (exact number takes priority).
DATASET_SIZE=medium
# SEED_STUDENTS=50000
